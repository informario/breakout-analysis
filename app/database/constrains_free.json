{
  "_description": "Experimental constraint spec for generating non-conventional switch port-count tuples. Roles and tiers have relaxed restrictions: unusual speed combinations, extreme oversubscription, multi-speed nodes, and cross-tier speed overlaps are all valid.",
  "_tuple_format": "(dc_type, role, {speed_gbps: port_count, ...})",
  "_generation_algorithm": {
    "asymmetric": [
      "1. Sample speed_pair (down_spd, up_spd) weighted by 'weight'",
      "2. Sample n_up from [min_up_ports, max_up_ports] in steps of port_granularity",
      "3. Sample oversub uniformly from oversub_range",
      "4. Compute n_down = round(oversub * n_up * up_spd / down_spd) aligned to port_granularity",
      "5. Validate: n_up + n_down <= max_total_ports AND n_down >= port_granularity",
      "6. If invalid, retry. Emit {down_spd: n_down, up_spd: n_up} (merge if down_spd == up_spd)"
    ],
    "symmetric": [
      "1. Sample speed entry weighted by 'weight'",
      "2. Sample n_ports from [min_ports, max_ports] in steps of port_granularity",
      "3. Emit {speed: n_ports}"
    ],
    "multi_speed": [
      "1. Sample a speed_group (list of 3 speeds: down, mid, up) weighted by 'weight'",
      "2. Sample n_up from [min_up_ports, max_up_ports] in steps of port_granularity",
      "3. Sample n_mid from [min_mid_ports, max_mid_ports] in steps of port_granularity",
      "4. Sample oversub uniformly from oversub_range",
      "5. Compute n_down = round(oversub * (n_up * up_spd + n_mid * mid_spd) / down_spd) aligned to port_granularity",
      "6. Validate: n_up + n_mid + n_down <= max_total_ports AND n_down >= port_granularity",
      "7. If invalid, retry. Emit {down_spd: n_down, mid_spd: n_mid, up_spd: n_up}"
    ]
  },
  "_notes": {
    "port_granularity": "Minimum grouping unit for port counts. Set to 1 to allow any count.",
    "oversub_range": "Values below 1.0 mean uplinks have MORE bandwidth than downlinks (reverse oversubscription, valid in storage or high-availability designs).",
    "weight": "Relative sampling probability. Unusual combinations have lower weight but are still reachable.",
    "speed units": "All speeds in Gbps",
    "multi_speed": "Port type that allows three distinct speed tiers on a single node (e.g. servers at 25G, inter-leaf at 100G, spine uplinks at 400G).",
    "unconventional_flags": "Fields marked with _uc_ prefix indicate parameters that deviate from industry norms intentionally.",
    "50G": "50G is a single-lane breakout (1\u00d750G from a 100G port, or 4\u00d750G from 200G). Present mainly as server-facing downlink in cloud/enterprise, WAN handoff in edge, and OOB management in AI clusters. Not used as spine speed except in legacy Tomahawk2 breakout mode."
  },
